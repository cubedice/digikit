+/// Is machine type `t` a free row of the run-time range: no module owns it and the image's row has no name. Without a registry no type is free.
+pub unsafe fn type_is_free<C: CoreApi>(core: &C, t: u32) -> bool {
+    let inf = dkrt_svc_params::dynreg(core);
+    if inf.is_null() {
+        return false;
+    }
+    let first = iw(inf, w::M_DYN0);
+    let Some(k) = t.checked_sub(first) else {
+        return false;
+    };
+    if k >= iw(inf, w::M_DYN_N) || k as usize >= MAX_MACH || t < iw(inf, w::M_FIRST) {
+        return false;
+    }
+    if rstate().mach_owner[k as usize] != 0 {
+        return false;
+    }
+    let row = iw(inf, w::M_ROWS) + (t - iw(inf, w::M_FIRST)) * iw(inf, w::M_ROW_SIZE);
+    let name = core.rd(row + iw(inf, w::O_NAME));
+    name == 0 || core.rd8(name) == 0
+}
