+    /// The `[key, number]` pairs the machines service planned for the module at index `selection` of the boot's selection (`instrument::resolve_types`): the
+    /// `machines` service file's export; returns how many (none without the file).
+    pub fn planned_ids(selection: u32, out: &mut [[u32; 2]; 8]) -> usize {
+        match find_export(MACHINES_PLANNED_IDS) {
+            Some(a) => unsafe {
+                (core::mem::transmute::<usize, unsafe extern "C" fn(u32, *mut u32) -> u32>(a)(selection, out.as_mut_ptr() as *mut u32) as usize).min(out.len())
+            },
+            None => 0,
+        }
+    }
+    /// Whether the machines service has machine type `id` taken in its rows: the `machines` service file's export; not taken without the file.
