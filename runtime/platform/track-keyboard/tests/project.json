{
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "name": "track-keyboard-tests",
  "tags": [
    "test-only"
  ],
  "implicitDependencies": [
    "core/track-keyboard",
    "core/keyboard-panel",
    "core/copy-watch",
    "core/fxview",
    "core/relay-input",
    "core/services/track-keyboard",
    "dkrt-svc-track-keyboard",
    "core/instrument-play",
    "core/services/instrument",
    "dkrt-svc-instrument"
  ],
  "metadata": {
    "runtimeAcceptance": [
      {
        "files": [
          "panel.device.test.ts",
          "midi.device.test.ts",
          "sequence.device.test.ts",
          "sequence-transition.device.test.ts",
          "arp-phase.device.test.ts",
          "keys-latency.device.test.ts",
          "pool.device.test.ts",
          "storage.device.test.ts",
          "track-clipboard.device.test.ts",
          "trig-clipboard.device.test.ts"
        ],
        "devices": [
          "dt2"
        ],
        "dsp": "sharc",
        "modules": [
          "core/services/track-keyboard"
        ],
        "patchModules": [
          "core/track-keyboard",
          "core/health"
        ]
      },
      {
        "files": [
          "canopy.device.test.ts"
        ],
        "devices": [
          "dt2"
        ],
        "dsp": "sharc",
        "modules": [
          "digikit/canopy",
          "core/services/machines",
          "core/services/instrument",
          "core/services/track-keyboard"
        ],
        "patchModules": [
          "core/track-keyboard",
          "core/instrument-play",
          "core/health"
        ],
        "incidental": [
          {
            "module": "digikit/canopy",
            "reason": "the instrument the track keyboard plays on the track; the test asserts the track keyboard's side, and CANOPY's own tests (modules/machine/digikit/canopy/tests) select on CANOPY's changes"
          },
          {
            "module": "core/services/machines",
            "reason": "the machine service CANOPY's types register with; the test asserts the track keyboard's ownership of a CANOPY track, not the machine rows"
          }
        ]
      }
    ]
  },
  "targets": {
    "test-device": {
      "cache": false
    }
  }
}
